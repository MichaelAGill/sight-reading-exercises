  "globalRules": {
    "examLikeFormat": {
      "previouslyUnseen": true,
      "unaccompanied": true,
      "previewSeconds": 30,
      "previewMayIncludeTryingNotes": true,
      "pieceCount": 1,
      "rationale": "ABRSM describes sight-reading as a short, unaccompanied piece not seen before, with half a minute to look through and optionally try some or all of it."
    },
    "cumulativeParameters": true,
    "cumulativeInterpretation": "Once a parameter is introduced at a grade, it remains available at later grades, but difficulty should increase gradually rather than automatically using every later feature at maximum density.",
    "generatorSafety": {
      "avoidUnmarkedOctaveSpansBelowGrade": 3,
      "avoidLargeHandStretches": true,
      "avoidPedalDependenceBelowGrade": 6,
      "avoidDensePolyphonyBelowGrade": 6,
      "avoidMoreThanOneNewMajorChallengePerPhrase": true,
      "preferPredictablePhraseLengths": true,
      "preferIdiomaticFingering": true,
      "rationale": "The learner needs to read, coordinate and keep a pulse in real time. Prepared-piece difficulty must not be copied wholesale into an unseen exercise."
    },
    "difficultyBudget": {
      "points": {
        "newKeyOrAccidentalLoad": 1,
        "rhythmicIrregularity": 1,
        "handMovementOrLeap": 1,
        "simultaneousNotesOrVoiceCount": 1,
        "clefOrRegisterChange": 1,
        "articulationOrDynamicChange": 1,
        "pedalOrOrnamentInstruction": 1,
        "tempoChange": 2
      },
      "rule": "The generated piece must not exceed the grade maxPoints, and should normally fall between targetMinPoints and targetMaxPoints.",
      "purpose": "This is an internal generation budget, not an ABRSM mark scheme."
    }
